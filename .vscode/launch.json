{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ccwebserver",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/ccwebserver",
      "args": ["-p", "8080"],
      "cwd": "${workspaceFolder}",
      "environment": [],
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build debug",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}